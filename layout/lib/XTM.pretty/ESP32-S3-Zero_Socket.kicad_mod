(footprint "ESP32-S3-Zero_Socket" (version 20241229) (generator "xtm-driver") (generator_version "9.0")
  (layer "F.Cu")
  (descr "Waveshare ESP32-S3-Zero plugged into two 1x9 2.54 mm female headers, 15.24 mm apart. Viewed from the side the module is on; place it on the bottom of the board to hang the module there. Pin order from Waveshare's top-view product photo: left column 1-9 from the USB-C end (5V, GND, 3V3, GP1-GP6), right column 10-18 from the antenna end (GP7-GP13, RX/GP44, TX/GP43). Holes as KiCad's PinSocket_1x09 footprint")
