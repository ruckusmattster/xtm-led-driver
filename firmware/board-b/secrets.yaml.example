# Copy to secrets.yaml (keep it out of version control) and fill in.
wifi_ssid: "venue-network"
wifi_password: "wifi-password"
fallback_password: "at-least-8-characters"   # the fixture's own hotspot if Wi-Fi fails
# The same on every fixture. Sync packets carry an HMAC under this key; fixtures with a
# different key ignore each other. 12 to 64 characters.
sync_key: "change-me-to-a-long-random-string"
# One API encryption key per fixture (it also encrypts and authenticates OTA updates):
# 32 random bytes, base64. Generate each with
#   python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
xtm1_api_key: "REPLACE-WITH-32-BYTE-BASE64-KEY"
xtm2_api_key: "REPLACE-WITH-32-BYTE-BASE64-KEY"
xtm3_api_key: "REPLACE-WITH-32-BYTE-BASE64-KEY"
xtm4_api_key: "REPLACE-WITH-32-BYTE-BASE64-KEY"
